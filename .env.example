# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# RevenueCat (Web Billing)
# Use rcb_sb_* for sandbox, rcb_* for production
VITE_REVENUECAT_API_KEY=rcb_sb_your-revenuecat-key

# Stripe Payment Links (fallback if RevenueCat unavailable)
VITE_STRIPE_LINK_STARTER=https://buy.stripe.com/your-starter-link
VITE_STRIPE_LINK_PRO=https://buy.stripe.com/your-pro-link
VITE_STRIPE_LINK_BUSINESS=https://buy.stripe.com/your-business-link

# Google Analytics
VITE_GA_ID=G-XXXXXXXXXX

# Google Ads Pixel (conversion tracking)
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXXX

# Dev mode (NEVER true in production!)
VITE_DEV_BYPASS_AUTH=false
